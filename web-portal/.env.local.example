# URL of the automation-server API
AUTOMATION_API_URL=http://localhost:8000

# Must match automation-server's ADMIN_SECRET (see automation-server/.env.local).
# A valid admin secret is enough for everything — the portal doesn't need a
# separately-generated API key.
ADMIN_SECRET=change-me-to-a-secure-secret

# Browser-facing URL for the noVNC live-view of headed scrapes when
# automation-server runs via Docker (see docker-compose.yml's
# automation-server service, port 6080).
NEXT_PUBLIC_VNC_URL=http://localhost:6080/vnc.html
