# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=lead_scraper

# API Authentication (REQUIRED for production)
ADMIN_SECRET=change-me-to-a-secure-secret

# VNC password for the noVNC live-view of headed (non-headless) scrapes,
# served on port 6080 when running via Docker. Only used in the Docker setup
# (see docker-compose.yml) — not read when running automation-server directly.
VNC_PASSWORD=change-me-to-a-secure-password

# Optional: Custom API key prefix
# API_KEY_PREFIX=anv_

# Outreach: SMTP for sending emails to leads (e.g. Gmail with an app password
# — https://myaccount.google.com/apppasswords). Leave unset to disable sending;
# outreach emails will fail cleanly and log the reason instead of crashing.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_APP_PASSWORD=your-16-char-app-password
# SMTP_FROM_NAME=Your Name

# Outreach: IMAP for detecting replies. Reuses SMTP_USER/SMTP_APP_PASSWORD
# (Gmail's app password works for both) — only override these if your inbox
# isn't Gmail. Leave everything above unset to disable reply checking too.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993

# App Configuration (for Docker)
PORT=8000
HOST=0.0.0.0
